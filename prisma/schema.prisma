generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  INVOICED
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

model CustomerRequest {
  id               String        @id @default(cuid())
  requestNumber    String        @unique
  customerName     String
  phone            String
  email            String?
  requestSource    String
  shippingMethod   String
  goodsCategory    String
  weightKg         Decimal?
  volumeCbm        Decimal?
  goodsDescription String
  createdAt        DateTime      @default(now())
  status           RequestStatus @default(NEW)
  updatedAt        DateTime      @updatedAt

  invoice Invoice?
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  customerRequestId String?          @unique
  customerRequest   CustomerRequest? @relation(fields: [customerRequestId], references: [id], onDelete: Restrict)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  currency String @default("USD")

  pricingBasis             PricingBasis @default(CBM)
  rateUsd                  Decimal      @default(0)
  handlingChargeUsd        Decimal      @default(0)
  documentationChargeUsd   Decimal      @default(0)
  specialHandlingChargeUsd Decimal      @default(0)
  discountUsd              Decimal      @default(0)

  exchangeRate Decimal @default(1)
  subtotalUsd  Decimal @default(0)
  totalGhs     Decimal @default(0)

  validUntil DateTime

  status InvoiceStatus @default(DRAFT)

  lines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model InvoiceLine {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  shipmentPricingId String
  shipmentPricing   ShipmentPricing @relation(fields: [shipmentPricingId], references: [id], onDelete: Restrict)

  description String?

  pricingBasis ShipmentPricingBasis

  billableQuantity Decimal?
  unitRateUsd      Decimal?
  lineTotalUsd     Decimal
  lineTotalGhs     Decimal

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([shipmentId])
  @@index([shipmentPricingId])
}

enum PricingBasis {
  CBM
  WEIGHT
  MANUAL
}

model BusinessSettings {
  id String @id @default(cuid())

  businessName String  @default("WILLIS PORT")
  tagline      String? @default("Shipping & Logistics")

  phone    String?
  whatsapp String?
  email    String?
  address  String?

  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ShippingMode {
  SEA
  AIR
  UNKNOWN
}

enum ShipmentStatus {
  RECEIVED
  ORIGIN
  LOADING_SCHEDULED
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  WAREHOUSE
  DELIVERED
  CANCELLED
}

enum ContainerStatus {
  PLANNING
  LOADING
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  ARRIVED
  CLOSED
  CANCELLED
}

model Customer {
  id String @id @default(cuid())

  name     String
  phone    String?
  whatsapp String?
  email    String?
  address  String?

  shipments Shipment[]
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
}

model Container {
  id String @id @default(cuid())

  containerNumber String @unique

  shippingMode ShippingMode

  estimatedLoadingDate DateTime?
  departureDate        DateTime?
  eta                  DateTime?
  actualArrivalDate    DateTime?

  status ContainerStatus @default(PLANNING)

  notes String?

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id             String @id @default(cuid())
  shipmentNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  trackingNumber String?

  description String?

  shippingMode ShippingMode
  goodsType    String?

  weightKg Decimal?

  declaredCbm   Decimal?
  actualCbm     Decimal?
  chargeableCbm Decimal?

  dateReceived         DateTime?
  estimatedLoadingDate DateTime?
  eta                  DateTime?

  status ShipmentStatus @default(RECEIVED)

  containerId String?
  container   Container? @relation(fields: [containerId], references: [id], onDelete: SetNull)

  pricings     ShipmentPricing[]
  invoiceLines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([trackingNumber])
  @@index([containerId])
  @@index([status])
  @@index([eta])
}

enum ShipmentPricingBasis {
  CBM
  KG
  MANUAL
}

enum ShipmentPricingStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

model ShipmentPricing {
  id String @id @default(cuid())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  pricingBasis ShipmentPricingBasis
  status       ShipmentPricingStatus @default(DRAFT)

  // Snapshot of measurements used for this calculation.
  actualCbm          Decimal?
  chargeableCbm      Decimal?
  weightKg           Decimal?
  chargeableWeightKg Decimal?

  // The actual quantity being billed.
  billableQuantity Decimal?

  // Example:
  // CBM: 0.15 × $250
  // KG:  34 × $8
  unitRateUsd Decimal?

  // Used when pricingBasis = MANUAL.
  manualChargeUsd Decimal?

  exchangeRateToGhs Decimal @default(1)

  // Customer-facing amounts.
  customerChargeUsd Decimal @default(0)
  customerChargeGhs Decimal @default(0)

  // Internal Willis Port financials.
  internalCostGhs Decimal?
  profitGhs       Decimal?

  invoiceLines InvoiceLine[]

  notes String?

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([status])
  @@index([pricingBasis])
}
