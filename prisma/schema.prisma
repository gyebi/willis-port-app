generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum RequestStatus {
  NEW
  INVOICED
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

model CustomerRequest {
  id               String   @id @default(cuid())
  requestNumber    String   @unique
  customerName     String
  phone            String
  email            String?
  requestSource    String
  shippingMethod   String
  goodsCategory    String
  weightKg         Decimal?
  volumeCbm        Decimal?
  goodsDescription String
  createdAt        DateTime @default(now())
  status           RequestStatus @default(NEW)
  updatedAt        DateTime @updatedAt


  invoice          Invoice?
}


model Invoice {
  id                String          @id @default(cuid())
  invoiceNumber     String          @unique

  customerRequestId String          @unique
  customerRequest   CustomerRequest @relation(fields: [customerRequestId], references: [id], onDelete: Restrict)

  currency          String          @default("USD")

  pricingBasis              PricingBasis @default(CBM)
  rateUsd                   Decimal      @default(0)
  handlingChargeUsd         Decimal      @default(0)
  documentationChargeUsd    Decimal      @default(0)
  specialHandlingChargeUsd  Decimal      @default(0)
  discountUsd               Decimal      @default(0)

  exchangeRate      Decimal         @default(1)
  subtotalUsd       Decimal         @default(0)
  totalGhs          Decimal         @default(0)

  validUntil        DateTime

  status            InvoiceStatus   @default(DRAFT)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum PricingBasis {
  CBM
  WEIGHT
  MANUAL
}