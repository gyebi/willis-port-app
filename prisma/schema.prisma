generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  INVOICED
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum InvoiceDeliveryChannel {
  EMAIL
  WHATSAPP
  SMS
  MAIL
  PRINT
}

enum InvoiceDeliveryStatus {
  PENDING
  INITIATED
  SENT
  FAILED
  PRINT_REQUESTED
  MAIL_PREPARED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

model CustomerRequest {
  id               String        @id @default(cuid())
  requestNumber    String        @unique
  customerName     String
  phone            String
  email            String?
  requestSource    String
  shippingMethod   String
  goodsCategory    String
  weightKg         Decimal?
  volumeCbm        Decimal?
  goodsDescription String
  createdAt        DateTime      @default(now())
  status           RequestStatus @default(NEW)
  updatedAt        DateTime      @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  shipmentId String?   @unique
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  invoice Invoice?

  @@index([customerId])
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  customerRequestId String?          @unique
  customerRequest   CustomerRequest? @relation(fields: [customerRequestId], references: [id], onDelete: Restrict)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  currency String @default("USD")

  pricingBasis             PricingBasis @default(CBM)
  rateUsd                  Decimal      @default(0)
  handlingChargeUsd        Decimal      @default(0)
  documentationChargeUsd   Decimal      @default(0)
  specialHandlingChargeUsd Decimal      @default(0)
  discountUsd              Decimal      @default(0)

  exchangeRate Decimal @default(1)
  subtotalUsd  Decimal @default(0)
  totalGhs     Decimal @default(0)

  validUntil DateTime

  status InvoiceStatus @default(DRAFT)

  lines      InvoiceLine[]
  documents  InvoiceDocument[]
  deliveries InvoiceDelivery[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model InvoiceDocument {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  storagePath String
  fileName    String

  generatedAt DateTime @default(now())
  version     Int      @default(1)
  isIssued    Boolean  @default(true)

  deliveries InvoiceDelivery[]

  @@index([invoiceId])
}

model InvoiceDelivery {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  invoiceDocumentId String?
  invoiceDocument   InvoiceDocument? @relation(fields: [invoiceDocumentId], references: [id], onDelete: SetNull)

  channel InvoiceDeliveryChannel

  recipient String?

  status InvoiceDeliveryStatus

  sentAt   DateTime?
  failedAt DateTime?

  failureReason     String?
  providerMessageId String?
  notes             String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([invoiceDocumentId])
  @@index([channel])
  @@index([status])
}

model Payment {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amountGhs Decimal
  method    PaymentMethod

  reference String?
  notes     String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
  amount     Decimal?
  paymentDate DateTime?
  paymentMethod PaymentMethod?
  receivedByUserId String?
  receivedByUser   AppUser? @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([method])
  @@index([receivedByUserId])
}

model InvoiceLine {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  lineType InvoiceLineType

  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  shipmentPricingId String?
  shipmentPricing   ShipmentPricing? @relation(fields: [shipmentPricingId], references: [id], onDelete: Restrict)

  description String

  pricingBasis ShipmentPricingBasis?

  billableQuantity Decimal?
  unitRateUsd      Decimal?

  lineTotalUsd Decimal
  lineTotalGhs Decimal

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([shipmentId])
  @@index([shipmentPricingId])
  @@index([lineType])
}

enum InvoiceLineType {
  SHIPMENT
  FREIGHT
  HANDLING
  DOCUMENTATION
  SPECIAL_HANDLING
  DELIVERY
  OTHER
}

enum PricingBasis {
  CBM
  WEIGHT
  MANUAL
}

model BusinessSettings {
  id String @id @default(cuid())

  businessName String  @default("WILLIS PORT")
  tagline      String? @default("Shipping & Logistics")

  phone    String?
  whatsapp String?
  email    String?
  address  String?

  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ShippingMode {
  SEA
  AIR
  UNKNOWN
}

enum ShipmentStatus {
  RECEIVED
  ORIGIN
  LOADING_SCHEDULED
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  WAREHOUSE
  DELIVERED
  CANCELLED
}

enum ContainerStatus {
  PLANNING
  LOADING
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  ARRIVED
  CLOSED
  CANCELLED
}

model Customer {
  id String @id @default(cuid())

  name     String
  phone    String?
  whatsapp String?
  email    String?
  address  String?

  shipments Shipment[]
  invoices  Invoice[]
  requests  CustomerRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
}

model Container {
  id String @id @default(cuid())

  containerNumber String @unique

  shippingMode ShippingMode

  estimatedLoadingDate DateTime?
  departureDate        DateTime?
  eta                  DateTime?
  actualArrivalDate    DateTime?

  status ContainerStatus @default(PLANNING)

  notes String?

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id             String @id @default(cuid())
  shipmentNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  trackingNumber String?

  description String?

  shippingMode ShippingMode

  serviceType ServiceType @default(STANDARD)

  goodsCategory GoodsCategory @default(NORMAL)

  goodsType String?

  weightKg           Decimal?
  chargeableWeightKg Decimal?

  declaredCbm   Decimal?
  actualCbm     Decimal?
  chargeableCbm Decimal?

  shippingCostGhs      Decimal?
  willisPortChargesGhs Decimal?
  profitGhs            Decimal?

  dateReceived         DateTime?
  calculatedEstimatedLoadingDate DateTime?
  estimatedLoadingDate DateTime?
  estimatedLoadingDateOverride DateTime?
  estimatedLoadingOverrideReason String?
  estimatedLoadingOverrideAt DateTime?
  estimatedLoadingOverrideByUserId String?
  estimatedLoadingOverrideByUser   AppUser? @relation("ShipmentLoadingOverrideBy", fields: [estimatedLoadingOverrideByUserId], references: [id], onDelete: SetNull)
  eta                  DateTime?
  sortingCompleteDate  DateTime?
  collectionDate       DateTime?

  status ShipmentStatus @default(RECEIVED)

  containerId String?
  container   Container? @relation(fields: [containerId], references: [id], onDelete: SetNull)

  pricings        ShipmentPricing[]
  invoiceLines    InvoiceLine[]
  customerRequest CustomerRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enteredByUserId String?
  enteredByUser   AppUser? @relation("ShipmentEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([trackingNumber])
  @@index([containerId])
  @@index([status])
  @@index([eta])
  @@index([collectionDate])
  @@index([enteredByUserId])
  @@index([estimatedLoadingOverrideByUserId])
}

enum ShipmentPricingBasis {
  CBM
  KG
  MANUAL
}

enum ShipmentPricingStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum ServiceType {
  STANDARD
  EXPRESS
}

enum GoodsCategory {
  NORMAL
  SPECIAL
}

model ShippingRate {
  id String @id @default(cuid())

  shippingMode  ShippingMode
  serviceType   ServiceType
  goodsCategory GoodsCategory

  pricingBasis ShipmentPricingBasis

  rateUsd Decimal

  unit String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shippingMode, serviceType, goodsCategory])
  @@index([shippingMode])
  @@index([serviceType])
  @@index([goodsCategory])
}

model ShipmentPricing {
  id String @id @default(cuid())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  pricingBasis ShipmentPricingBasis
  status       ShipmentPricingStatus @default(DRAFT)

  actualCbm          Decimal?
  chargeableCbm      Decimal?
  weightKg           Decimal?
  chargeableWeightKg Decimal?

  billableQuantity Decimal?
  unitRateUsd      Decimal?
  manualChargeUsd  Decimal?

  freightChargeUsd         Decimal @default(0)
  handlingChargeUsd        Decimal @default(0)
  documentationChargeUsd   Decimal @default(0)
  specialHandlingChargeUsd Decimal @default(0)
  deliveryChargeUsd        Decimal @default(0)

  otherChargeDescription String?
  otherChargeUsd         Decimal @default(0)

  exchangeRateToGhs Decimal @default(1)

  customerChargeUsd Decimal @default(0)
  customerChargeGhs Decimal @default(0)

  internalCostGhs Decimal?
  profitGhs       Decimal?

  notes String?

  approvedAt DateTime?

  invoiceLines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([status])
  @@index([pricingBasis])
}

enum UserRole {
  AGENT
  MANAGER
}

model AppUser {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  displayName String?
  role        UserRole
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enteredShipments Shipment[] @relation("ShipmentEnteredBy")
  receivedPayments Payment[] @relation("PaymentReceivedBy")
  loadingDateOverrides Shipment[] @relation("ShipmentLoadingOverrideBy")
}
