generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  INVOICED
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

model CustomerRequest {
  id               String        @id @default(cuid())
  requestNumber    String        @unique
  customerName     String
  phone            String
  email            String?
  requestSource    String
  shippingMethod   String
  goodsCategory    String
  weightKg         Decimal?
  volumeCbm        Decimal?
  goodsDescription String
  createdAt        DateTime      @default(now())
  status           RequestStatus @default(NEW)
  updatedAt        DateTime      @updatedAt

  invoice Invoice?
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  customerRequestId String          @unique
  customerRequest   CustomerRequest @relation(fields: [customerRequestId], references: [id], onDelete: Restrict)

  currency String @default("USD")

  pricingBasis             PricingBasis @default(CBM)
  rateUsd                  Decimal      @default(0)
  handlingChargeUsd        Decimal      @default(0)
  documentationChargeUsd   Decimal      @default(0)
  specialHandlingChargeUsd Decimal      @default(0)
  discountUsd              Decimal      @default(0)

  exchangeRate Decimal @default(1)
  subtotalUsd  Decimal @default(0)
  totalGhs     Decimal @default(0)

  validUntil DateTime

  status InvoiceStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PricingBasis {
  CBM
  WEIGHT
  MANUAL
}

model BusinessSettings {
  id String @id @default(cuid())

  businessName String  @default("WILLIS PORT")
  tagline      String? @default("Shipping & Logistics")

  phone    String?
  whatsapp String?
  email    String?
  address  String?

  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ShippingMode {
  SEA
  AIR
  UNKNOWN
}

enum ShipmentStatus {
  RECEIVED
  ORIGIN
  LOADING_SCHEDULED
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  WAREHOUSE
  DELIVERED
  CANCELLED
}

enum ContainerStatus {
  PLANNING
  LOADING
  IN_TRANSIT
  CUSTOMS_CLEARANCE
  ARRIVED
  CLOSED
  CANCELLED
}

model Customer {
  id String @id @default(cuid())

  name     String
  phone    String?
  whatsapp String?
  email    String?
  address  String?

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
}

model Container {
  id String @id @default(cuid())

  containerNumber String @unique

  shippingMode ShippingMode

  estimatedLoadingDate DateTime?
  departureDate        DateTime?
  eta                  DateTime?
  actualArrivalDate    DateTime?

  status ContainerStatus @default(PLANNING)

  notes String?

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id             String @id @default(cuid())
  shipmentNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  trackingNumber String?

  description String?

  shippingMode ShippingMode
  goodsType    String?

  weightKg Decimal?

  declaredCbm   Decimal?
  actualCbm     Decimal?
  chargeableCbm Decimal?

  dateReceived         DateTime?
  estimatedLoadingDate DateTime?
  eta                  DateTime?

  status ShipmentStatus @default(RECEIVED)

  containerId String?
  container   Container? @relation(fields: [containerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([trackingNumber])
  @@index([containerId])
  @@index([status])
  @@index([eta])
}
